# env.example — copy to ~/.jcode/plugins/self-improve/env and edit.
#
# A hook entry in ~/.jcode/config.toml is a path, not a command with arguments,
# so the settings this plugin needs live in this file, sourced by self-improve.sh
# before its defaults are applied. Same pattern as the aroute credential file at
# ~/.config/jcode/provider-aroute.env. Everything is optional: unset means the
# built-in default.

# --- memory-wire sharing -------------------------------------------------

# Base URL of a memory-wire server. The plugin appends the route itself:
#   POST {url}/banks/{bank}/retain
# Unset means no memory call at all, so the plugin has no dependency and the
# test suite runs on a machine without a server.
SELF_IMPROVE_MEMORY_URL=http://127.0.0.1:8888

# Bank each recorded project fact is shared into. Left unset on purpose: the
# plugin derives it the way memory-wire does (owner/repo from the origin remote,
# else the directory name), so each project's facts stay in their own namespace.
# Pinning one shared bank makes every project's memory recallable in every other
# project's context. Set it only to force a specific bank.
# SELF_IMPROVE_MEMORY_BANK=omp

# --- everything else (optional) -------------------------------------------
# See docs/CONFIGURATION.md for the full list.
#
# SELF_IMPROVE_SKILL_THRESHOLD=0.65
# SELF_IMPROVE_GENOME_THRESHOLD=0.70
# SELF_IMPROVE_ROUTER_URL=https://aroute.ishanparihar.com/v1/chat/completions
# SELF_IMPROVE_MAX_PER_HOUR=6
# SELF_IMPROVE_MAX_PROFILE_PER_HOUR=24
# SELF_IMPROVE_MAX_LEDGER_ENTRIES=500